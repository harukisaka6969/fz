// Prisma schema for the therapist personal homepage (admin + customer portal)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Therapist {
  id           String   @id @default(cuid())
  /// Set only for therapists onboarded with their own login (prototype: blank password bypass).
  loginId      String?  @unique
  passwordHash String?
  name         String
  catchCopy    String
  bio          String
  age          Int?
  height       Int?
  bodyType     String?
  bloodType    String?
  areaOfWork   String?
  workingHours String?
  photoUrl     String?
  snsUrl       String?
  sortOrder    Int      @default(0)
  /// Becomes true once the therapist has logged into her own account. Only verified
  /// therapists are visible to customers.
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes             TherapistNote[]
  blogPosts         BlogPost[]
  availabilityRules AvailabilityRule[]
  bookings          Booking[]
  customerNotes     CustomerNote[]
}

model Customer {
  id           String   @id @default(cuid())
  loginId      String   @unique
  passwordHash String
  name         String
  phone        String?
  email        String?
  createdAt    DateTime @default(now())

  coupons        Coupon[]
  histories      TreatmentHistory[]
  reviews        Review[]
  messages       Message[]
  notes          CustomerNote[]
  therapistNotes TherapistNote[]
  bookings       Booking[]
}

/// A therapist's recurring weekly availability window, valid for a finite date range.
model AvailabilityRule {
  id          String    @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  /// 0 = Sunday .. 6 = Saturday
  dayOfWeek   Int
  /// "HH:mm" local wall-clock time
  startTime   String
  endTime     String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

enum BookingStatus {
  CONFIRMED
  CANCELED
}

model Booking {
  id          String        @id @default(cuid())
  therapistId String
  therapist   Therapist     @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  menuItemId  String?
  menuItem    MenuItem?     @relation(fields: [menuItemId], references: [id])
  startAt     DateTime
  endAt       DateTime
  status      BookingStatus @default(CONFIRMED)
  createdAt   DateTime      @default(now())
}

/// Private notes about a customer. Never shown to the customer.
/// therapistId null = written by the admin/owner (visible to admin only).
/// therapistId set = written by that specific therapist (visible to admin and that therapist only).
model CustomerNote {
  id          String     @id @default(cuid())
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  therapistId String?
  therapist   Therapist? @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime   @default(now())
}

/// A customer's private notes about a therapist. Never shown to the therapist/admin.
model TherapistNote {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  title       String
  body        String
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String
  durationMin Int
  price       Int
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  treatmentHistories TreatmentHistory[]
  bookings           Booking[]
}

enum DiscountType {
  PERCENT
  AMOUNT
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  title         String
  description   String
  discountType  DiscountType
  discountValue Int
  validFrom     DateTime
  validTo       DateTime
  isActive      Boolean      @default(true)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
}

model TreatmentHistory {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  menuItemId  String?
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id])
  date        DateTime
  durationMin Int
  price       Int
  note        String?
  createdAt   DateTime  @default(now())
}

model Review {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String
  reply       String?
  repliedAt   DateTime?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

enum SenderType {
  ADMIN
  CUSTOMER
}

model Message {
  id             String     @id @default(cuid())
  customerId     String
  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sender         SenderType
  body           String
  readByAdmin    Boolean    @default(false)
  readByCustomer Boolean    @default(false)
  createdAt      DateTime   @default(now())
}
